# Browser-visible tldraw key; required for non-localhost use. Rebuild after changes.
TLDRAW_LICENSE_KEY=
# Optional index list; unset defaults to notebook and scratch.
NOTEBOOK_ROOMS=math,physics,scratch
# Alternatively use JSON with labels and optional detail/color:
# NOTEBOOK_ROOMS='[{"id":"math","label":"Math","color":"#476b84"},{"id":"physics","label":"Physics"},{"id":"scratch","label":"Scratch"}]'
# Export/image validation requires an external renderer and Python with Pillow:
# NOTEBOOK_PYTHON=/path/to/python3
# NOTEBOOK_CLI=/path/to/notebook_bot.py
